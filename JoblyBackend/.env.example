# Local dev defaults to SQLite (zero extra setup).
# For PostgreSQL + pgvector (e.g. via docker-compose):
# DATABASE_URL=postgresql+asyncpg://jobly:jobly@localhost:5432/jobly
DATABASE_URL=sqlite+aiosqlite:///./jobly.db

LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=lm-studio
LLM_TIMEOUT_SECONDS=120

STORAGE_DIR=./storage
ENABLE_SCHEDULER=true
SCRAPE_INTERVAL_MINUTES=60
SCRAPE_ON_STARTUP=false
ENABLE_DAILY_NOTIFICATION=true
DAILY_NOTIFICATION_INTERVAL_HOURS=24
JUSTJOIN_ITEMS_PER_PAGE=50
JUSTJOIN_MAX_PAGES=2
MAX_CV_FILE_SIZE_BYTES=5242880
MAX_CV_PAGES=10
MAX_CVS_PER_USER=10
